# scripts/sim_cli_examples/pick_and_place.cli
#
# Walk-pick-walk-place scripted via the CLI. Run with:
#
#   python scripts/sim_cli.py --script scripts/sim_cli_examples/pick_and_place.cli
#
# Lines starting with '#' are comments. Coordinate args support arithmetic
# and named anchors: box.{x,y,z}, target.{x,y,z}, pelvis.{x,y,z},
# lhand.{x,y,z}, rhand.{x,y,z}, plus pi, tau, deg(...), rad(...).

status

# 1. Walk to the table.
goto table

# 2. Reach above the box, descend onto it, grasp.
reach left box.x box.y box.z+0.10
reach left box.x box.y box.z+0.04
grasp left

# 3. Lift the box clear of the table.
reach left box.x box.y box.z+0.20

# 4. Walk to the shelf (carrying the box).
goto shelf

# 5. Reach above the place target, lower the box, release, let gravity settle.
reach left target.x target.y target.z+0.16
reach left target.x target.y target.z+0.06
release
settle 1.5

# 6. Walk back to the start.
goto home
status

quit
